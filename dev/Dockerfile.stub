# Throwaway image for the Task 2 dashboard work.
#
# The real application image is Task 3 / Person C's job (root Dockerfile).
# This one packages the stub backend + the dashboard so the browser -> API
# path can be exercised in containers.
#
# build: docker build -f dev/Dockerfile.stub -t monitor-stub:latest .
# run:   docker run -d --name api --network monitor-net -p 3000:3000 monitor-stub:latest

FROM node:22-alpine

WORKDIR /app

COPY dev/stub-backend.cjs ./stub-backend.cjs
COPY public ./public

ENV PORT=3000
ENV HOST=0.0.0.0

EXPOSE 3000

HEALTHCHECK --interval=10s --timeout=3s --start-period=3s --retries=3 \
  CMD wget -qO- http://127.0.0.1:3000/health || exit 1

CMD ["node", "stub-backend.cjs"]
